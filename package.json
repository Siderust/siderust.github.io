{
  "name": "siderust-website",
  "type": "module",
  "version": "1.0.0",
  "description": "Official website for the Siderust organization and its projects",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "serve:published": "bash scripts/serve-published-local.sh",
    "build:wasm-demo": "bash scripts/build-wasm-demo.sh",
    "generate:projects": "tsx scripts/generate-project-metadata.ts",
    "validate:i18n": "tsx scripts/validate-i18n.ts",
    "validate:packages": "tsx scripts/validate-package-contract.ts",
    "validate:projects": "tsx scripts/validate-project-snippets.ts",
    "build": "astro check && npm run validate:i18n && npm run validate:projects && npm run validate:packages && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/tailwind": "^5.1.3",
    "astro": "^6.4.4",
    "siderust-js": "0.1.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.22.4"
  }
}
