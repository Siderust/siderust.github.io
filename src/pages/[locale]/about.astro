---
/**
 * About Page (localized)
 */
import Layout from '../../layouts/Layout.astro';
import siteConfig from '../../site.config';
import { getLocaleStaticPaths, t, tArray, type Locale } from '../../i18n/index';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = Astro.params.locale as Locale;
const values = tArray(locale, 'site.values');
---

<Layout 
  locale={locale}
  title={t(locale, 'about.title', { name: siteConfig.name })}
  description={t(locale, 'about.seoDescription', { name: siteConfig.name })}
>
  <!-- Header Section -->
  <section class="py-16 md:py-20 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950">
    <div class="container-custom">
      <div class="max-w-3xl">
        <h1 class="section-heading">{t(locale, 'about.title', { name: siteConfig.name })}</h1>
        <p class="section-subheading">
          {t(locale, 'about.subtitle')}
        </p>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-12 md:py-16 bg-white dark:bg-gray-950">
    <div class="container-custom">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">{t(locale, 'about.ourMission')}</h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-6">
          {t(locale, 'site.mission')}
        </p>
        <div class="bg-gradient-to-r from-brand-50 to-rust-50 dark:from-brand-950/30 dark:to-rust-950/30 border-l-4 border-brand-500 p-6 rounded-r-lg">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">{t(locale, 'about.whoWeServe')}</h3>
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            <li class="flex items-start gap-2">
              <span class="text-brand-500 mt-1">•</span>
              <span>{t(locale, 'about.serveSpacecraft')}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-500 mt-1">•</span>
              <span>{t(locale, 'about.serveObservatory')}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-500 mt-1">•</span>
              <span>{t(locale, 'about.serveResearchers')}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-500 mt-1">•</span>
              <span>{t(locale, 'about.serveEmbedded')}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  {values.length > 0 && (
    <section class="py-12 md:py-16 bg-gray-50 dark:bg-gray-900/50">
      <div class="container-custom">
        <div class="max-w-3xl">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">{t(locale, 'about.ourValues')}</h2>
          <div class="space-y-6">
            {values.map((value, index) => (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-rust-500 flex items-center justify-center text-white font-bold shrink-0">
                  {index + 1}
                </div>
                <p class="text-gray-600 dark:text-gray-400 pt-2">{value}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- What We Do Section -->
  <section class="py-12 md:py-16 bg-white dark:bg-gray-950">
    <div class="container-custom">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">{t(locale, 'about.whatWeBuildTitle')}</h2>
        <div class="prose prose-gray dark:prose-invert max-w-none">
          <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
            {t(locale, 'about.whatWeBuildIntro')}
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-white">{t(locale, 'about.buildValidation')}</strong>: {t(locale, 'about.buildValidationDesc')}</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-white">{t(locale, 'about.buildSafety')}</strong>: {t(locale, 'about.buildSafetyDesc')}</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-white">{t(locale, 'about.buildTypes')}</strong>: {t(locale, 'about.buildTypesDesc')}</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-white">{t(locale, 'about.buildRepro')}</strong>: {t(locale, 'about.buildReproDesc')}</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span class="text-gray-600 dark:text-gray-400"><strong class="text-gray-900 dark:text-white">{t(locale, 'about.buildPerf')}</strong>: {t(locale, 'about.buildPerfDesc')}</span>
            </li>
          </ul>
        </div>
        <div class="mt-8 p-6 bg-gray-50 dark:bg-gray-900/50 rounded-lg border border-gray-200 dark:border-gray-800">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">{t(locale, 'about.ourEcosystem')}</h3>
          <div class="space-y-3 text-sm">
            <div>
              <a href="https://github.com/Siderust/siderust" target="_blank" rel="noopener noreferrer" class="font-mono text-brand-600 dark:text-brand-400 hover:underline">siderust</a>
              <span class="text-gray-600 dark:text-gray-400">: {t(locale, 'about.ecoSiderust')}</span>
            </div>
            <div>
              <a href="https://github.com/Siderust/affn" target="_blank" rel="noopener noreferrer" class="font-mono text-brand-600 dark:text-brand-400 hover:underline">affn</a>
              <span class="text-gray-600 dark:text-gray-400">: {t(locale, 'about.ecoAffn')}</span>
            </div>
            <div>
              <a href="https://github.com/Siderust/qtty" target="_blank" rel="noopener noreferrer" class="font-mono text-brand-600 dark:text-brand-400 hover:underline">qtty</a>
              <span class="text-gray-600 dark:text-gray-400">: {t(locale, 'about.ecoQtty')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contributing Section -->
  <section id="contributing" class="py-12 md:py-16 bg-gray-50 dark:bg-gray-900/50 scroll-mt-20">
    <div class="container-custom">
      <div class="max-w-3xl">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">{t(locale, 'about.howToContribute')}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8">
          {t(locale, 'about.contributeIntro')}
        </p>

        <div class="space-y-8">
          <!-- Getting Started -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">{t(locale, 'about.gettingStarted')}</h3>
            <ol class="space-y-4">
              {[1,2,3,4,5].map(i => (
                <li class="flex items-start gap-4">
                  <span class="w-8 h-8 rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-600 dark:text-brand-400 flex items-center justify-center text-sm font-bold shrink-0">{i}</span>
                  <div>
                    <p class="text-gray-900 dark:text-white font-medium">{t(locale, `about.step${i}Title`)}</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{t(locale, `about.step${i}Desc`)}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <!-- Development Setup -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">{t(locale, 'about.devSetup')}</h3>
            <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
              <pre class="text-sm text-gray-100 font-mono"><code># Clone the repository
git clone https://github.com/Siderust/&lt;project-name&gt;
cd &lt;project-name&gt;

# Build the project
cargo build

# Run tests
cargo test

# Run clippy for linting
cargo clippy

# Format code
cargo fmt</code></pre>
            </div>
          </div>

          <!-- Code Guidelines -->
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">{t(locale, 'about.codeGuidelines')}</h3>
            <ul class="space-y-3">
              {['guidelineStyle', 'guidelineTests', 'guidelineDocs', 'guidelinePR', 'guidelineUnsafe'].map(key => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-brand-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-gray-600 dark:text-gray-400">{t(locale, `about.${key}`)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-12 p-6 rounded-xl bg-gradient-to-r from-brand-600 to-rust-600 text-white">
          <h3 class="text-lg font-semibold">{t(locale, 'about.readyToContribute')}</h3>
          <p class="mt-2 text-white/80">
            {t(locale, 'about.readyToContributeDesc')}
          </p>
          <a
            href={siteConfig.orgUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white text-brand-700 font-medium hover:bg-gray-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            {t(locale, 'about.browseRepos')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Maintainers Section -->
  {siteConfig.maintainers && siteConfig.maintainers.length > 0 && (
    <section class="py-12 md:py-16 bg-white dark:bg-gray-950">
      <div class="container-custom">
        <div class="max-w-3xl">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">{t(locale, 'about.maintainers')}</h2>
          <div class="grid sm:grid-cols-2 gap-6">
            {siteConfig.maintainers.map((maintainer) => (
              <a
                href={`https://github.com/${maintainer.github}`}
                target="_blank"
                rel="noopener noreferrer"
                class="card p-4 flex items-center gap-4 hover:border-brand-500/50 transition-colors"
              >
                <img
                  src={`https://github.com/${maintainer.github}.png?size=64`}
                  alt={maintainer.name}
                  class="w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700"
                  loading="lazy"
                />
                <div>
                  <p class="font-medium text-gray-900 dark:text-white">{maintainer.name}</p>
                  {maintainer.role && (
                    <p class="text-sm text-gray-500 dark:text-gray-400">{maintainer.role}</p>
                  )}
                  <p class="text-sm text-gray-500 dark:text-gray-400">@{maintainer.github}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Placeholder for maintainers if not configured -->
  {(!siteConfig.maintainers || siteConfig.maintainers.length === 0) && (
    <section class="py-12 md:py-16 bg-white dark:bg-gray-950">
      <div class="container-custom">
        <div class="max-w-3xl">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">{t(locale, 'about.connectWithUs')}</h2>
          <p class="text-gray-600 dark:text-gray-400 mb-6">
            {t(locale, 'about.connectDesc')}
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href={siteConfig.orgUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              {t(locale, 'about.githubOrg')}
            </a>
            <a
              href={`${siteConfig.orgUrl}/.github/discussions`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
              </svg>
              {t(locale, 'about.joinDiscussions')}
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>
