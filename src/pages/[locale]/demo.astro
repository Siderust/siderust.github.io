---
/**
 * Interactive Demo Lab (localized)
 *
 * Three coordinated tools powered by Siderust's WebAssembly engine:
 *   • Sky Plot, altitude / azimuth vs time
 *   • Coordinate Playground, frame & center transforms
 *   • Time Lab, UTC / JD / MJD conversion and observation periods
 *
 * Plotly.js loaded from CDN (same pattern as the benchmarks page).
 * WASM packages vendored into public/vendor/ via the build:wasm-demo script.
 */
import Layout from '../../layouts/Layout.astro';
import { getLocaleStaticPaths, t, type Locale } from '../../i18n/index';

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = Astro.params.locale as Locale;
const demoClientI18n = JSON.stringify({
  altitudeChart: t(locale, 'demo.altitudeChart'),
  azimuthChart: t(locale, 'demo.azimuthChart'),
  events: t(locale, 'demo.events'),
  eventType: t(locale, 'demo.eventType'),
  timeUtc: t(locale, 'demo.timeUtc'),
  altitude: t(locale, 'demo.altitude'),
  azimuth: t(locale, 'demo.azimuth'),
  rise: t(locale, 'demo.rise'),
  set: t(locale, 'demo.set'),
  riseAtThreshold: t(locale, 'demo.riseAtThreshold'),
  setAtThreshold: t(locale, 'demo.setAtThreshold'),
  upperCulmination: t(locale, 'demo.upperCulmination'),
  lowerCulmination: t(locale, 'demo.lowerCulmination'),
  circumpolar: t(locale, 'demo.circumpolar'),
  neverRises: t(locale, 'demo.neverRises'),
  moonPhaseLabel: t(locale, 'demo.moonPhaseLabel'),
  illumination: t(locale, 'demo.illumination'),
  noEvents: t(locale, 'demo.noEvents'),
  azimuthCompass: t(locale, 'demo.azimuthCompass'),
  hoursFromStart: t(locale, 'demo.hoursFromStart'),
  timeOfDay: t(locale, 'demo.timeOfDay'),
  skySphere: t(locale, 'demo.skySphere'),
  skySphereHint: t(locale, 'demo.skySphereHint'),
  skyLayers: t(locale, 'demo.skyLayers'),
  skyToggleHorizon: t(locale, 'demo.skyToggleHorizon'),
  skyToggleThreshold: t(locale, 'demo.skyToggleThreshold'),
  skyToggleStars: t(locale, 'demo.skyToggleStars'),
  skyToggleGrid: t(locale, 'demo.skyToggleGrid'),
  skyToggleLabels: t(locale, 'demo.skyToggleLabels'),
});
---

<Layout
  locale={locale}
  title={t(locale, 'demo.title')}
  description={t(locale, 'demo.seoDescription')}
>

  <!-- ───────────── Hero ───────────── -->
  <section class="relative overflow-hidden py-16 md:py-20">
    <!-- Starfield / gradient background -->
    <div class="absolute inset-0 bg-gradient-to-b from-gray-950 via-indigo-950/80 to-gray-950 dark:from-gray-950 dark:via-indigo-950/60 dark:to-gray-950" aria-hidden="true"></div>
    <div class="absolute inset-0 opacity-30 dark:opacity-50" aria-hidden="true"
      style="background-image: radial-gradient(1px 1px at 10% 20%, white 1px, transparent 0), radial-gradient(1px 1px at 30% 60%, white 1px, transparent 0), radial-gradient(1.5px 1.5px at 50% 15%, white 1px, transparent 0), radial-gradient(1px 1px at 70% 45%, white 1px, transparent 0), radial-gradient(1.5px 1.5px at 85% 70%, white 1px, transparent 0), radial-gradient(1px 1px at 20% 80%, white 1px, transparent 0), radial-gradient(1px 1px at 60% 90%, white 1px, transparent 0), radial-gradient(1.5px 1.5px at 90% 25%, white 1px, transparent 0), radial-gradient(1px 1px at 40% 40%, white 1px, transparent 0), radial-gradient(1px 1px at 75% 85%, white 1px, transparent 0);">
    </div>
    <div class="relative container-custom text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-500/20 text-indigo-300 text-sm font-medium mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400"></span>
        </span>
        {t(locale, 'demo.poweredBy')}
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white">{t(locale, 'demo.heroTitle')}</h1>
      <p class="mt-4 text-lg text-indigo-200/80 max-w-2xl mx-auto" set:html={t(locale, 'demo.heroDesc')} />
    </div>
  </section>

  <!-- ───────────── Loading overlay ───────────── -->
  <div id="wasm-loading" class="py-20 text-center">
    <div class="inline-flex items-center gap-3 text-gray-500 dark:text-gray-400">
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
      {t(locale, 'demo.loading')}
    </div>
  </div>
  <div id="wasm-error" class="hidden py-20 text-center">
    <p class="text-red-500 dark:text-red-400 font-medium">{t(locale, 'demo.loadError')}</p>
  </div>

  <!-- ───────────── Main Lab (hidden until WASM ready) ───────────── -->
  <div id="lab-root" class="hidden">

    <!-- Tab navigation -->
    <div class="sticky top-16 z-40 border-b border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-950/90 backdrop-blur-lg">
      <div class="container-custom">
        <nav class="flex gap-1 overflow-x-auto py-2 -mb-px" role="tablist" aria-label="Lab tools">
          <button role="tab" aria-selected="true" aria-controls="panel-sky" id="tab-sky"
            class="tab-btn tab-active px-4 py-2.5 text-sm font-medium rounded-lg whitespace-nowrap transition-colors">
            <svg class="w-4 h-4 inline-block mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
            {t(locale, 'demo.tabSkyPlot')}
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-coords" id="tab-coords"
            class="tab-btn px-4 py-2.5 text-sm font-medium rounded-lg whitespace-nowrap transition-colors text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50">
            <svg class="w-4 h-4 inline-block mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
            {t(locale, 'demo.tabCoords')}
          </button>
          <button role="tab" aria-selected="false" aria-controls="panel-time" id="tab-time"
            class="tab-btn px-4 py-2.5 text-sm font-medium rounded-lg whitespace-nowrap transition-colors text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50">
            <svg class="w-4 h-4 inline-block mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {t(locale, 'demo.tabTime')}
          </button>
        </nav>
      </div>
    </div>

    <!-- ══════════════ SKY PLOT PANEL ══════════════ -->
    <section id="panel-sky" role="tabpanel" aria-labelledby="tab-sky" class="py-8 md:py-12">
      <div class="container-custom">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-1">{t(locale, 'demo.skyPlotTitle')}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl text-sm">{t(locale, 'demo.skyPlotDesc')}</p>

        <div class="grid xl:grid-cols-3 gap-6 items-start mb-6">
          <!-- Observer -->
          <div class="card p-4 h-full">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">{t(locale, 'demo.observer')}</h3>
              <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">{t(locale, 'demo.observerPreset')}</label>
              <select id="sky-obs-preset" class="demo-select w-full">
                <option value="roqueDeLasMuchachos" selected>Roque de los Muchachos</option>
                <option value="elParanal">Paranal</option>
                <option value="maunaKea">Mauna Kea</option>
                <option value="laSilla">La Silla</option>
                <option value="custom">{t(locale, 'demo.observerCustom')}</option>
              </select>
              <div id="sky-obs-custom" class="hidden mt-3 space-y-2">
                <div>
                  <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.longitude')}</label>
                  <input id="sky-obs-lon" type="number" step="any" value="-17.8925" class="demo-input w-full" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.latitude')}</label>
                  <input id="sky-obs-lat" type="number" step="any" value="28.7543" class="demo-input w-full" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.height')}</label>
                  <input id="sky-obs-h" type="number" step="any" value="2396" class="demo-input w-full" />
                </div>
              </div>
          </div>

          <!-- Target -->
          <div class="card p-4 h-full">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">{t(locale, 'demo.target')}</h3>
              <select id="sky-target-type" class="demo-select w-full mb-2">
                <option value="body" selected>{t(locale, 'demo.targetBody')}</option>
                <option value="star">{t(locale, 'demo.targetStar')}</option>
                <option value="custom">{t(locale, 'demo.targetCustom')}</option>
              </select>
              <div id="sky-target-body-wrap">
                <select id="sky-body" class="demo-select w-full"></select>
              </div>
              <div id="sky-target-star-wrap" class="hidden">
                <select id="sky-star" class="demo-select w-full"></select>
              </div>
              <div id="sky-target-custom-wrap" class="hidden space-y-2">
                <div>
                  <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.customName')}</label>
                  <input id="sky-custom-name" type="text" value="Custom Target" class="demo-input w-full" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.customRa')}</label>
                  <input id="sky-custom-ra" type="number" step="any" value="83.6333" class="demo-input w-full" />
                </div>
                <div>
                  <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.customDec')}</label>
                  <input id="sky-custom-dec" type="number" step="any" value="22.0145" class="demo-input w-full" />
                </div>
              </div>
          </div>

          <!-- Time -->
          <div class="card p-4 space-y-3 h-full">
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.date')}</label>
                <input id="sky-date" type="date" class="demo-input w-full" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.horizon')}</label>
                <input id="sky-horizon" type="number" step="any" value="0" class="demo-input w-full" />
              </div>
              <div class="pt-1">
                <button id="sky-share-btn" type="button" class="btn-primary w-full py-2 text-sm">
                  <svg class="w-4 h-4 inline-block mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 015.656 5.656l-3 3a4 4 0 01-5.656-5.656m-1.656 1.656a4 4 0 00-5.656 5.656l3 3a4 4 0 005.656-5.656" /></svg>
                  {t(locale, 'demo.copyShareLink')}
                </button>
                <span id="sky-share-status" class="hidden block mt-1 text-xs text-emerald-600 dark:text-emerald-400 text-center"></span>
              </div>
          </div>
        </div>

        <div class="space-y-6 min-w-0">
          <div class="card p-4">
              <div id="chart-altitude" class="w-full" style="height:380px" role="img" aria-label={t(locale, 'demo.altChartAriaLabel')}>
                <div class="flex items-center justify-center h-full text-gray-400 dark:text-gray-600 text-sm">{t(locale, 'demo.altitudeChart')}</div>
              </div>
          </div>
          <div class="card p-4">
              <div id="chart-azimuth" class="w-full" style="height:380px" role="img" aria-label={t(locale, 'demo.azChartAriaLabel')}>
                <div class="flex items-center justify-center h-full text-gray-400 dark:text-gray-600 text-sm">{t(locale, 'demo.azimuthChart')}</div>
              </div>
          </div>
          <div class="card p-4">
              <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
                <span class="text-gray-500 dark:text-gray-400 font-medium pr-1">{t(locale, 'demo.skyLayers')}:</span>
                <label class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 cursor-pointer select-none">
                  <input type="checkbox" id="sky-toggle-horizon" class="accent-amber-500 w-3.5 h-3.5" />
                  <span class="text-gray-700 dark:text-gray-200">{t(locale, 'demo.skyToggleHorizon')}</span>
                </label>
                <label class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 cursor-pointer select-none">
                  <input type="checkbox" id="sky-toggle-threshold" class="accent-red-500 w-3.5 h-3.5" checked />
                  <span class="text-gray-700 dark:text-gray-200">{t(locale, 'demo.skyToggleThreshold')}</span>
                </label>
                <label class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 cursor-pointer select-none">
                  <input type="checkbox" id="sky-toggle-stars" class="accent-indigo-400 w-3.5 h-3.5" checked />
                  <span class="text-gray-700 dark:text-gray-200">{t(locale, 'demo.skyToggleStars')}</span>
                </label>
                <label class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 cursor-pointer select-none">
                  <input type="checkbox" id="sky-toggle-grid" class="accent-blue-400 w-3.5 h-3.5" checked />
                  <span class="text-gray-700 dark:text-gray-200">{t(locale, 'demo.skyToggleGrid')}</span>
                </label>
                <label class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 cursor-pointer select-none">
                  <input type="checkbox" id="sky-toggle-labels" class="accent-amber-400 w-3.5 h-3.5" checked />
                  <span class="text-gray-700 dark:text-gray-200">{t(locale, 'demo.skyToggleLabels')}</span>
                </label>
              </div>
              <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">{t(locale, 'demo.skySphereHint')}</p>
              <div id="chart-skysphere" class="w-full relative rounded-md overflow-hidden" style="height:480px; background:#06091c" role="img" aria-label={t(locale, 'demo.skySphereAriaLabel')}>
                <div id="chart-skysphere-fallback" class="flex items-center justify-center h-full text-gray-400 dark:text-gray-600 text-sm">{t(locale, 'demo.skySphere')}</div>
              </div>
          </div>
        </div>

        <div class="card p-4 space-y-3 mt-6">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white">{t(locale, 'demo.events')}</h3>
          <div id="sky-special" class="hidden"></div>
          <div id="sky-events"></div>
          <div id="sky-moon-phase" class="hidden"></div>
        </div>
      </div>
    </section>

    <!-- ══════════════ COORDINATE PLAYGROUND ══════════════ -->
    <section id="panel-coords" role="tabpanel" aria-labelledby="tab-coords" class="hidden py-8 md:py-12">
      <div class="container-custom">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-1">{t(locale, 'demo.coordsTitle')}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-2xl text-sm">{t(locale, 'demo.coordsDesc')}</p>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Direction Transform -->
          <div class="card p-5 space-y-4">
            <h3 class="font-semibold text-gray-900 dark:text-white">{t(locale, 'demo.dirTransform')}</h3>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.fromFrame')}</label>
                <select id="dir-from" class="demo-select w-full">
                  <option value="ICRS" selected>ICRS</option>
                  <option value="EclipticMeanJ2000">Ecliptic Mean J2000</option>
                  <option value="EquatorialMeanJ2000">Equatorial Mean J2000</option>
                  <option value="EquatorialMeanOfDate">Equatorial Mean of Date</option>
                  <option value="EquatorialTrueOfDate">Equatorial True of Date</option>
                </select>
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.toFrame')}</label>
                <select id="dir-to" class="demo-select w-full">
                  <option value="ICRS">ICRS</option>
                  <option value="EclipticMeanJ2000" selected>Ecliptic Mean J2000</option>
                  <option value="EquatorialMeanJ2000">Equatorial Mean J2000</option>
                  <option value="EquatorialMeanOfDate">Equatorial Mean of Date</option>
                  <option value="EquatorialTrueOfDate">Equatorial True of Date</option>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.polar')}</label>
                <input id="dir-polar" type="number" step="any" value="90" class="demo-input w-full" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.azimuthInput')}</label>
                <input id="dir-azimuth" type="number" step="any" value="45" class="demo-input w-full" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.epoch')}</label>
                <input id="dir-epoch" type="number" step="any" value="2451545.0" class="demo-input w-full" />
              </div>
            </div>
            <button id="dir-go" class="btn-primary w-full py-2 text-sm hidden">{t(locale, 'demo.transform')}</button>
            <div id="dir-result" class="hidden bg-gray-50 dark:bg-gray-900/50 rounded-lg p-4 text-sm font-mono space-y-1"></div>
          </div>

          <!-- Local Horizontal -->
          <div class="card p-5 space-y-4">
            <h3 class="font-semibold text-gray-900 dark:text-white">{t(locale, 'demo.localHorizontal')}</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400">{t(locale, 'demo.localHorizontalDesc')}</p>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.fromFrame')}</label>
                <select id="hor-frame" class="demo-select w-full">
                  <option value="ICRS" selected>ICRS</option>
                  <option value="EclipticMeanJ2000">Ecliptic Mean J2000</option>
                  <option value="EquatorialMeanJ2000">Equatorial Mean J2000</option>
                  <option value="EquatorialMeanOfDate">Equatorial Mean of Date</option>
                  <option value="EquatorialTrueOfDate">Equatorial True of Date</option>
                </select>
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.epoch')}</label>
                <input id="hor-epoch" type="number" step="any" value="2451545.0" class="demo-input w-full" />
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.polar')}</label>
                <input id="hor-polar" type="number" step="any" value="83.6333" class="demo-input w-full" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.azimuthInput')}</label>
                <input id="hor-azimuth" type="number" step="any" value="22.0145" class="demo-input w-full" />
              </div>
            </div>
            <div class="border-t border-gray-200 dark:border-gray-800 pt-3">
              <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-2">{t(locale, 'demo.observer')}</label>
              <select id="hor-obs-preset" class="demo-select w-full">
                <option value="roqueDeLasMuchachos" selected>Roque de los Muchachos</option>
                <option value="elParanal">Paranal</option>
                <option value="maunaKea">Mauna Kea</option>
                <option value="laSilla">La Silla</option>
              </select>
            </div>
            <button id="hor-go" class="btn-primary w-full py-2 text-sm hidden">{t(locale, 'demo.transform')}</button>
            <div id="hor-result" class="hidden bg-gray-50 dark:bg-gray-900/50 rounded-lg p-4 text-sm font-mono space-y-1"></div>
          </div>

          <!-- Position Transform -->
          <div class="card p-5 space-y-4 md:col-span-2">
            <h3 class="font-semibold text-gray-900 dark:text-white">{t(locale, 'demo.posTransform')}</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400">{t(locale, 'demo.posTransformDesc')}</p>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.body')}</label>
                <select id="pos-body" class="demo-select w-full"></select>
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.epoch')}</label>
                <input id="pos-epoch" type="number" step="any" value="2451545.0" class="demo-input w-full" />
              </div>
              <div>
                <label class="block text-xs text-gray-500 dark:text-gray-400 mb-0.5">{t(locale, 'demo.toCenter')}</label>
                <select id="pos-center" class="demo-select w-full">
                  <option value="Barycentric" selected>Barycentric</option>
