---
/**
 * 404 Not Found Page
 *
 * Detects locale from the request path when available; falls back to defaultLocale.
 */
import Layout from '../layouts/Layout.astro';
import { t, localePath, getLocaleFromPath, defaultLocale } from '../i18n/index';

const locale = getLocaleFromPath(Astro.url.pathname) || defaultLocale;
---

<Layout title={t(locale, 'notFound.title')} noindex locale={locale}>
  <section class="py-20 md:py-32">
    <div class="container-custom">
      <div class="max-w-xl mx-auto text-center">
        <div class="text-8xl font-bold gradient-text">404</div>
        <h1 class="mt-4 text-2xl font-bold text-gray-900 dark:text-white">
          {t(locale, 'notFound.heading')}
        </h1>
        <p class="mt-4 text-gray-600 dark:text-gray-400">
          {t(locale, 'notFound.description')}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={localePath(locale, '/')} class="btn-primary">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            {t(locale, 'notFound.goHome')}
          </a>
          <a href={localePath(locale, '/projects')} class="btn-secondary">
            {t(locale, 'notFound.browseProjects')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
