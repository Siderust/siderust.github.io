---
/**
 * Base Layout
 * 
 * The main layout wrapper for all pages.
 * Accepts a `locale` prop used to set `<html lang>`, inject hreflang
 * alternates, and pass locale context down to Header / Footer.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import {
  defaultLocale,
  localeBcp47,
  locales,
  switchLocalePath,
  type Locale,
} from '../i18n/index';
import siteConfig from '../site.config';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { locale = defaultLocale, ...seoProps } = Astro.props;
const currentPath = Astro.url.pathname;
const bcp47 = localeBcp47[locale];
---

<!DOCTYPE html>
<html lang={bcp47} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    
    <SEO locale={locale} {...seoProps} />

    <!-- hreflang alternates for every locale + x-default -->
    {locales.map((loc) => (
      <link
        rel="alternate"
        hreflang={localeBcp47[loc]}
        href={new URL(switchLocalePath(currentPath, loc), siteConfig.siteUrl).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(switchLocalePath(currentPath, defaultLocale), siteConfig.siteUrl).href}
    />
    
    <!-- Prevent FOUC for dark mode -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      if (getTheme() === 'dark') {
        document.documentElement.classList.add('dark');
      }
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-600 focus:text-white focus:rounded-lg"
    >
      Skip to main content
    </a>
    
    <Header currentPath={currentPath} locale={locale} />
    
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    
    <Footer locale={locale} />
  </body>
</html>
